    private void BeginEditChannel(Channel channel)
    {
        State.EditingChannel = channel;
        _editName = channel.Name;
        _editColor = channel.Color;
        _editWidth = channel.LineWidth;
        _editLineStyle = channel.LineStyle;
        _editSmooth = channel.Smooth;
        _editSmoothWindow = channel.SmoothWindow;
    }

    private void CancelEditChannel() => State.EditingChannel = null;

    private void ApplyEditChannel()
    {
        if (State.EditingChannel == null)
            return;
        var channel = State.EditingChannel;
        if (!string.IsNullOrWhiteSpace(_editName))
            channel.Name = _editName.Trim();
        channel.Color = _editColor;
        channel.LineWidth = Math.Clamp(_editWidth, 0.5f, 10f);
        channel.LineStyle = _editLineStyle;
        channel.Smooth = _editSmooth;
        channel.SmoothWindow = Math.Clamp(_editSmoothWindow | 1, 3, 501);
        State.EditingChannel = null;
        OnChannelConfigChanged();
    }

