    private void ApplyRanges()
    {
        if (TryParse(_rangeYMin, out double yMin)) PlotSettings.YMin = yMin;
        if (TryParse(_rangeYMax, out double yMax)) PlotSettings.YMax = yMax;
        if (TryParse(_rangeXMin, out double xMin)) PlotSettings.XMin = xMin;
        if (TryParse(_rangeXMax, out double xMax)) PlotSettings.XMax = xMax;
        State.ShowRanges = false;
        State.ScheduleSave();
    }

    private static bool TryParse(string text, out double value) =>
        double.TryParse(text, NumberStyles.Float, CultureInfo.InvariantCulture, out value) ||
        double.TryParse(text, NumberStyles.Float, CultureInfo.CurrentCulture, out value);

    private async Task<(double X, double Y)> PointFromEvent(PointerEventArgs e)
    {
        try
        {
            var point = await JS.InvokeAsync<SvgPoint>("spSvgPoint", _plotElement, e.ClientX, e.ClientY);
            return (point.X, point.Y);
        }
        catch
        {
            return (-1, -1);
        }
    }

    private async Task OnSplitterDown(PointerEventArgs e)
    {
        _draggingSplitter = true;
        _splitterStartY = e.ClientY;
        _splitterStartHeight = _consoleHeight;
        await JS.InvokeVoidAsync("spCapturePointer", _splitterElement, e.PointerId);
    }

    private void OnSplitterMove(PointerEventArgs e)
    {
        if (!_draggingSplitter)
            return;
        _consoleHeight = Math.Clamp(_splitterStartHeight + (int)(_splitterStartY - e.ClientY), 86, 520);
    }

    private void OnSplitterUp(PointerEventArgs e) => _draggingSplitter = false;

    private async Task OnPointerDown(PointerEventArgs e)
    {
        _contextMenu = false;
        var point = await PointFromEvent(e);
        if (e.Button is 0 or 1)
            await JS.InvokeVoidAsync("spCapturePointer", _plotElement, e.PointerId);
        if (State.Mode == PlotMode.ThreeD)
        {
            if (e.Button == 0)
            {
                _dragging3d = true;
                _lastMouse = point;
            }
            return;
        }
        if (State.Mode != PlotMode.Time)
            return;

        if (e.Button == 1)
        {
            InitViewFromCurrent();
            _panning = true;
            _lastMouse = point;
        }
        else if (e.Button == 0)
        {
            _selecting = true;
            _dragMoved = false;
            _dragStart = point;
            _selection = new PlotRect(point.X, point.Y, 0, 0);
        }
    }

    private async Task OnPointerMove(PointerEventArgs e)
    {
        var point = await PointFromEvent(e);
        _mousePosition = point;
        if (_dragging3d)
        {
            State.RotationY += (point.X - _lastMouse.X) * 0.01;
            State.RotationX = Math.Clamp(State.RotationX + (point.Y - _lastMouse.Y) * 0.01, -1.5, 1.5);
            _lastMouse = point;
        }
        else if (_panning)
        {
            PanBy(point);
            _lastMouse = point;
        }
        else if (_selecting)
        {
            if (Math.Abs(point.X - _dragStart.X) > 4 || Math.Abs(point.Y - _dragStart.Y) > 4)
                _dragMoved = true;
            if (_dragMoved)
            {
                _selection = new PlotRect(
                    Math.Min(_dragStart.X, point.X), Math.Min(_dragStart.Y, point.Y),
                    Math.Abs(point.X - _dragStart.X), Math.Abs(point.Y - _dragStart.Y));
            }
        }
    }

    private async Task OnPointerUp(PointerEventArgs e)
    {
        var point = await PointFromEvent(e);
        _mousePosition = point;
        _dragging3d = _panning = false;
        if (!_selecting)
            return;
        _selecting = false;

        if (!_dragMoved)
        {
            if (_suppressMarker)
                _suppressMarker = false;
            else
                PlaceMarker(point.X);
        }
        else if (_selection.Width > 8 && _selection.Height > 8)
        {
            ZoomTo(_selection);
        }
        _selection = new PlotRect();
    }

    private void OnPointerLeave(PointerEventArgs e)
    {
        _lastMouse = _mousePosition = (-1, -1);
        _dragging3d = _panning = _selecting = false;
        _selection = new PlotRect();
    }

    private void OnDoubleClick(MouseEventArgs e)
    {
        PlotSettings.ResetView();
        _suppressMarker = true;
    }

    [JSInvokable]
    public void OnPlotWheel(double x, double y, double deltaY, bool ctrlKey, bool altKey, bool shiftKey)
    {
        if (State.Mode != PlotMode.Time)
            return;
        _mousePosition = (x, y);
        if (x < SvgPlotter.Plot.Left || x > SvgPlotter.Plot.Right ||
            y < SvgPlotter.Plot.Top || y > SvgPlotter.Plot.Bottom)
            return;

        int direction = deltaY < 0 ? 1 : -1;
        if (ctrlKey)
            ZoomAt(_mousePosition, direction > 0 ? 0.8 : 1.25);
        else if (altKey && shiftKey)
            StretchY(_mousePosition, direction > 0 ? 0.8 : 1.25);
        else if (altKey)
            StretchX(_mousePosition, direction > 0 ? 0.8 : 1.25);
        else if (shiftKey)
            PanX(-direction * 0.15);
        else
            PanY(direction * 0.15);
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnContextMenu(MouseEventArgs e)
    {
        if (State.Mode == PlotMode.Time)
        {
            _exportXFrom = PlotSettings.LastXMin.ToString("0.###", CultureInfo.InvariantCulture);
            _exportXTo = PlotSettings.LastXMax.ToString("0.###", CultureInfo.InvariantCulture);
            _exportYFrom = PlotSettings.LastYMin.ToString("0.###", CultureInfo.InvariantCulture);
            _exportYTo = PlotSettings.LastYMax.ToString("0.###", CultureInfo.InvariantCulture);
        }
        _contextX = e.OffsetX;
        _contextY = e.OffsetY;
        _contextMenu = true;
    }

    private void PlaceMarker(double x)
    {
        var rect = SvgPlotter.Plot;
        if (x < rect.Left || x > rect.Right)
            return;
        double value = PlotSettings.LastXMin + (x - rect.Left) * (PlotSettings.LastXMax - PlotSettings.LastXMin) / rect.Width;
        if (PlotSettings.MarkerA != null && PlotSettings.MarkerB != null)
        {
            PlotSettings.MarkerA = value;
            PlotSettings.MarkerB = null;
        }
        else if (PlotSettings.MarkerA == null)
        {
            PlotSettings.MarkerA = value;
        }
        else
        {
            PlotSettings.MarkerB = value;
        }
    }

    private void InitViewFromCurrent()
    {
        PlotSettings.ViewXMin ??= PlotSettings.LastXMin;
        PlotSettings.ViewXMax ??= PlotSettings.LastXMax;
        PlotSettings.ViewYMin ??= PlotSettings.LastYMin;
        PlotSettings.ViewYMax ??= PlotSettings.LastYMax;
    }

    private void ZoomAt((double X, double Y) point, double factor)
    {
        var rect = SvgPlotter.Plot;
        double x0 = PlotSettings.ViewXMin ?? PlotSettings.LastXMin;
        double x1 = PlotSettings.ViewXMax ?? PlotSettings.LastXMax;
        double spanX = Math.Clamp((x1 - x0) * factor, 2, DataHub.HISTORY);
        double fx = Math.Clamp((point.X - rect.Left) / rect.Width, 0, 1);
        double anchorX = x0 + fx * (x1 - x0);
        double newX0 = anchorX - fx * spanX, newX1 = newX0 + spanX;
        if (State.XIndex < 0 && newX0 < 0)
        {
            newX1 -= newX0;
            newX0 = 0;
        }
        PlotSettings.ViewXMin = newX0;
        PlotSettings.ViewXMax = newX1;

        double y0 = PlotSettings.ViewYMin ?? PlotSettings.LastYMin;
        double y1 = PlotSettings.ViewYMax ?? PlotSettings.LastYMax;
        double spanY = Math.Max((y1 - y0) * factor, 1e-9);
        double fy = Math.Clamp((rect.Bottom - point.Y) / rect.Height, 0, 1);
        double anchorY = y0 + fy * (y1 - y0);
        PlotSettings.ViewYMin = anchorY - fy * spanY;
        PlotSettings.ViewYMax = PlotSettings.ViewYMin + spanY;
    }

    private void StretchX((double X, double Y) point, double factor)
    {
        var rect = SvgPlotter.Plot;
        double x0 = PlotSettings.ViewXMin ?? PlotSettings.LastXMin;
        double x1 = PlotSettings.ViewXMax ?? PlotSettings.LastXMax;
        double span = Math.Clamp((x1 - x0) * factor, 2, DataHub.HISTORY);
        double fraction = Math.Clamp((point.X - rect.Left) / rect.Width, 0, 1);
        double anchor = x0 + fraction * (x1 - x0);
        double new0 = anchor - fraction * span, new1 = new0 + span;
        if (State.XIndex < 0 && new0 < 0)
        {
            new1 -= new0;
            new0 = 0;
        }
        PlotSettings.ViewXMin = new0;
        PlotSettings.ViewXMax = new1;
    }

    private void StretchY((double X, double Y) point, double factor)
    {
        var rect = SvgPlotter.Plot;
        double y0 = PlotSettings.ViewYMin ?? PlotSettings.LastYMin;
        double y1 = PlotSettings.ViewYMax ?? PlotSettings.LastYMax;
        double span = Math.Max((y1 - y0) * factor, 1e-9);
        double fraction = Math.Clamp((rect.Bottom - point.Y) / rect.Height, 0, 1);
        double anchor = y0 + fraction * (y1 - y0);
        PlotSettings.ViewYMin = anchor - fraction * span;
        PlotSettings.ViewYMax = PlotSettings.ViewYMin + span;
    }

    private void PanX(double fraction)
    {
        InitViewFromCurrent();
        if (PlotSettings.ViewXMin is not { } x0 || PlotSettings.ViewXMax is not { } x1)
            return;
        double delta = (x1 - x0) * fraction;
        double new0 = x0 + delta, new1 = x1 + delta;
        if (State.XIndex < 0 && new0 < 0)
        {
            new1 -= new0;
            new0 = 0;
        }
        PlotSettings.ViewXMin = new0;
        PlotSettings.ViewXMax = new1;
    }

    private void PanY(double fraction)
    {
        InitViewFromCurrent();
        if (PlotSettings.ViewYMin is not { } y0 || PlotSettings.ViewYMax is not { } y1)
            return;
        double delta = (y1 - y0) * fraction;
        PlotSettings.ViewYMin = y0 + delta;
        PlotSettings.ViewYMax = y1 + delta;
    }

    private void ZoomTo(PlotRect selection)
    {
        var rect = SvgPlotter.Plot;
        double x0 = PlotSettings.LastXMin + (selection.Left - rect.Left) * (PlotSettings.LastXMax - PlotSettings.LastXMin) / rect.Width;
        double x1 = PlotSettings.LastXMin + (selection.Right - rect.Left) * (PlotSettings.LastXMax - PlotSettings.LastXMin) / rect.Width;
        if (x1 - x0 < 1e-9)
            return;
        PlotSettings.ViewXMin = State.XIndex < 0 ? Math.Max(0, x0) : x0;
        PlotSettings.ViewXMax = x1;

        double y0 = PlotSettings.LastYMin + (rect.Bottom - selection.Bottom) * (PlotSettings.LastYMax - PlotSettings.LastYMin) / rect.Height;
        double y1 = PlotSettings.LastYMin + (rect.Bottom - selection.Top) * (PlotSettings.LastYMax - PlotSettings.LastYMin) / rect.Height;
        if (y1 < y0)
            (y0, y1) = (y1, y0);
        PlotSettings.ViewYMin = y0;
        PlotSettings.ViewYMax = y1;
    }

    private void PanBy((double X, double Y) point)
    {
        var rect = SvgPlotter.Plot;
        double dx = (point.X - _lastMouse.X) * (PlotSettings.LastXMax - PlotSettings.LastXMin) / rect.Width;
        double dy = (point.Y - _lastMouse.Y) * (PlotSettings.LastYMax - PlotSettings.LastYMin) / rect.Height;
        if (PlotSettings.ViewXMin is { } x0 && PlotSettings.ViewXMax is { } x1)
        {
            PlotSettings.ViewXMin = x0 - dx;
            PlotSettings.ViewXMax = x1 - dx;
        }
        if (PlotSettings.ViewYMin is { } y0 && PlotSettings.ViewYMax is { } y1)
        {
            PlotSettings.ViewYMin = y0 + dy;
            PlotSettings.ViewYMax = y1 + dy;
        }
    }

    private void OnSendKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            SendCurrent();
    }

    private void SendCurrent()
    {
        string line = _sendText.Trim();
        if (line.Length == 0)
            return;
        if (State.SendLine(line))
            _sendText = "";
    }

    private void StartExport(string kind)
    {
        _contextMenu = false;
        _exportKind = kind;
        if (State.Mode == PlotMode.Time)
        {
            State.ShowExportRange = true;
        }
        else
        {
            _ = ConfirmExport();
        }
    }

    private async Task ConfirmExport()
    {
        State.ShowExportRange = false;
        bool useX = _exportUseX;
        double xFrom = 0, xTo = 0, yFrom = 0, yTo = 0;
        if (useX)
        {
            if (!TryParse(_exportXFrom, out xFrom) || !TryParse(_exportXTo, out xTo))
                return;
            if (xTo < xFrom)
                (xFrom, xTo) = (xTo, xFrom);
        }
        bool useY = State.Mode == PlotMode.Time && _exportUseY;
        if (useY)
        {
            if (!TryParse(_exportYFrom, out yFrom) || !TryParse(_exportYTo, out yTo))
                return;
            if (yTo < yFrom)
                (yFrom, yTo) = (yTo, yFrom);
        }

        if (useX)
        {
            PlotSettings.ViewXMin = xFrom;
            PlotSettings.ViewXMax = xTo;
        }
        if (useY)
        {
            PlotSettings.ViewYMin = yFrom;
            PlotSettings.ViewYMax = yTo;
        }

        switch (_exportKind)
        {
            case "png":
                await ExportPngAsync();
                break;
            case "csv":
                await ExportCsvAsync(useX, xFrom, xTo);
                break;
            default:
                await ExportSvgAsync();
                break;
        }

        if (useX || useY)
            PlotSettings.ResetView();
    }

    private async Task ExportSvgAsync()
    {
        string svg = BuildSvg(forExport: true);
        string? file = await ExportService.SaveTextAsync(
            T("Сохранить снимок графика", "Save plot snapshot"),
            "serialplot.svg", "SVG", new[] { ".svg" }, svg);
        if (file != null)
            State.Status = $"{T("снимок сохранён", "snapshot saved")}: {file}";
    }

    private async Task ExportPngAsync()
    {
        string svg = BuildSvg(forExport: true);
        string dataUrl = await JS.InvokeAsync<string>("spSvgToPngDataUrl", svg, SvgPlotter.Width, SvgPlotter.Height);
        const string prefix = "data:image/png;base64,";
        if (!dataUrl.StartsWith(prefix))
            return;
        byte[] bytes = Convert.FromBase64String(dataUrl[prefix.Length..]);
        string? file = await ExportService.SaveBytesAsync(
            T("Сохранить снимок графика", "Save plot snapshot"),
            "serialplot.png", "PNG", new[] { ".png" }, bytes);
        if (file != null)
            State.Status = $"{T("снимок сохранён", "snapshot saved")}: {file}";
    }

    private async Task ExportCsvAsync(bool useRange, double xFrom, double xTo)
    {
        if (DataHub.Count == 0)
            return;
        string csv = State.BuildCsv(useRange, xFrom, xTo);
        string? file = await ExportService.SaveTextAsync(
            T("Экспорт данных каналов", "Export channel data"),
            "serialplot.csv", "CSV", new[] { ".csv" }, csv);
        if (file != null)
            State.Status = $"CSV {T("сохранён", "saved")}: {file}";
    }

    [JSInvokable]
    public void OnHotkey(string key, bool ctrlKey, bool altKey, bool shiftKey)
    {
        switch (key)
        {
            case "F1":
                State.ShowHelp = !State.ShowHelp;
                break;
            case "F12":
                CycleTheme();
                break;
            case "Escape":
                State.ShowHelp = State.ShowSimulator = State.ShowRanges = State.ShowExportRange = false;
                State.EditingChannel = null;
                State.ErrorMessage = null;
                _contextMenu = false;
                break;
            case " ":
                State.TogglePause();
                break;
            case "ArrowLeft" when State.Mode == PlotMode.Time:
                PanX(-0.15);
                break;
            case "ArrowRight" when State.Mode == PlotMode.Time:
                PanX(0.15);
                break;
            case "ArrowUp" when State.Mode == PlotMode.Time:
                PanY(0.15);
                break;
            case "ArrowDown" when State.Mode == PlotMode.Time:
                PanY(-0.15);
                break;
            case "+" or "=" when State.Mode == PlotMode.Time:
                ZoomAt(PlotCenter(), 0.8);
                break;
            case "-" when State.Mode == PlotMode.Time:
                ZoomAt(PlotCenter(), 1.25);
                break;
            case "0" when State.Mode == PlotMode.Time:
                PlotSettings.ResetView();
                break;
        }
        _ = InvokeAsync(StateHasChanged);
    }

    private static (double X, double Y) PlotCenter() =>
        (SvgPlotter.Plot.Left + SvgPlotter.Plot.Width / 2, SvgPlotter.Plot.Top + SvgPlotter.Plot.Height / 2);

    [JSInvokable]
    public void ToggleHelp() => State.ShowHelp = !State.ShowHelp;

    [JSInvokable]
    public void CloseHelp() => State.ShowHelp = false;

