    private sealed class SvgPoint
    {
        public double X { get; set; }
        public double Y { get; set; }
    }

    public void Dispose()
    {
        _disposed = true;
        State.Changed -= OnStateChanged;
        _renderTimer?.Dispose();
        try
        {
            _ = JS.InvokeVoidAsync("spPlotWheel.dispose");
            _ = JS.InvokeVoidAsync("spHotkeys.dispose");
        }
        catch { }
        _hotkeysReference?.Dispose();
        State.SaveSettings();
    }
}
