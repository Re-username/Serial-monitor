@namespace SerialPlotter.Blazor.Pages
@page "/"
@using System.Globalization
@inject AppState State
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Serial Plotter</PageTitle>

<div class="plotter-page">
    <header class="topbar">
        <div class="toolbar-row">
            <div class="brand"><span class="brand-mark"></span><span>Serial Plotter</span></div>

            <span class="label">@T("Порт", "Port")</span>
            <select class="field" value="@State.SelectedPort" @onchange="OnPortChanged" style="min-width:112px">
                @if (State.PortNames.Length == 0)
                {
                    <option value="">@T("нет портов", "no ports")</option>
                }
                @foreach (string port in State.PortNames)
                {
                    <option value="@port">@port</option>
                }
            </select>
            <button class="btn" @onclick="RefreshPorts">⟳</button>

            <span class="label">@T("Бодрейт", "Baud")</span>
            <input class="field baud" @bind="State.BaudText" inputmode="numeric" />
            <select class="field baud-preset" value="" @onchange="OnBaudSelected" title="@T("Типовые бодрейты", "Common baud rates")">
                <option value="">▾</option>
                @foreach (int baud in AppState.Bauds)
                {
                    <option value="@baud">@baud</option>
                }
            </select>

            <button class="btn primary" disabled="@State.Connecting" @onclick="ToggleConnect">
                @(State.Serial.IsOpen ? T("Отключить", "Disconnect") : T("Подключить", "Connect"))
            </button>

            <span class="label">@T("Режим", "Mode")</span>
            <select class="field" value="@State.Mode" @onchange="OnModeChanged">
                <option value="Time">@T("Время", "Time")</option>
                <option value="Polar">@T("Полярный", "Polar")</option>
                <option value="ThreeD">3D</option>
                <option value="Fft">FFT</option>
            </select>

            <button class="btn" @onclick="() => State.ShowSimulator = true">@T("Симулятор", "Simulator")</button>
            <button class="btn" @onclick="() => State.ShowChannels = !State.ShowChannels">@T("Каналы", "Channels")</button>
            <button class="btn" @onclick="State.TogglePause">@(DataHub.Paused ? T("Продолжить", "Resume") : T("Пауза", "Pause"))</button>

            <details class="menu" open="@(_toolsOpen ? "open" : null)">
                <summary class="btn">@T("Инструменты", "Tools") ▾</summary>
                <div class="menu-panel">
                    <button @onclick="() => State.ShowRanges = true">@T("Диапазоны графика…", "Plot ranges…")</button>
                    <button @onclick="ResetView">@T("Сброс вида и маркеров", "Reset view and markers")</button>
                    <button @onclick="State.FullReset">@T("Полный сброс", "Full reset")</button>
                    <hr />
                    <label>@T("Сглаживание", "Smoothing")</label>
                    <select class="field small" value="@PlotSettings.GlobalSmooth" @onchange="OnGlobalSmoothChanged">
                        <option value="None">@T("Нет", "None")</option>
                        <option value="MovingAverage">@T("Скользящее среднее", "Moving average")</option>
                        <option value="Median">@T("Медиана", "Median")</option>
                        <option value="Gaussian">@T("Гауссово", "Gaussian")</option>
                        <option value="Exponential">@T("Экспоненциальное", "Exponential")</option>
                    </select>
                    <label>@T("Окно", "Window")</label>
                    <input class="field small" type="number" min="3" max="501" step="2" @bind="PlotSettings.GlobalSmoothWindow" @bind:after="State.ScheduleSave" />
                    <hr />
                    <label class="checkbox"><input type="checkbox" @bind="State.DtrReset" @bind:after="State.ScheduleSave" /> @T("DTR при подключении", "DTR on connect")</label>
                    <label>@T("Кодировка порта", "Port encoding")</label>
                    <select class="field small" @bind="State.PortEncoding" @bind:after="State.ScheduleSave">
                        <option value="utf-8">UTF-8</option>
                        <option value="cp1251">Windows-1251</option>
                        <option value="ascii">ASCII</option>
                        <option value="utf-16">UTF-16</option>
                    </select>
                    <label>@T("Язык", "Language")</label>
                    <select class="field small" value="@(Lang.English ? "en" : "ru")" @onchange="OnLanguageChanged">
                        <option value="ru">Русский</option>
                        <option value="en">English</option>
                    </select>
                    <label>@T("Тема", "Theme")</label>
                    <select class="field small" value="@State.ThemeName" @onchange="OnThemeChanged">
                        <option value="cyberpunk">Cyberpunk</option>
                        <option value="dark">@T("Тёмная", "Dark")</option>
                        <option value="light">@T("Светлая", "Light")</option>
                    </select>
                </div>
            </details>

            <button class="btn" @onclick="CycleTheme" title="@T("Сменить тему (F12)", "Cycle theme (F12)")">@ThemeButtonText</button>
            <button class="btn ghost" @onclick="() => State.ShowHelp = true">F1</button>
            <div class="status-pill" title="@State.Status">@State.Status</div>
        </div>

        @if (State.Mode == PlotMode.ThreeD)
        {
            <div class="mode-settings">
                <span class="label">3D:</span>
                <select class="field small" @bind="State.Time3DAxis">
                    <option value="0">@(VisibleChannelCount() == 2 ? T("авто: t → X", "auto: t → X") : T("без времени", "no time"))</option>
                    <option value="1">t → X</option>
                    <option value="2">t → Y</option>
                    <option value="3">t → Z</option>
                </select>
                <label class="checkbox"><input type="checkbox" @bind="State.Spin3D" /> @T("Вращение", "Spin")</label>
            </div>
        }
        else if (State.Mode == PlotMode.Fft)
        {
            <div class="mode-settings">
                <span class="label">@T("Частота, Гц", "Sample rate, Hz")</span>
                <input class="field small" type="number" min="1" max="1000000" step="10" @bind="PlotSettings.SampleRate" @bind:after="State.ScheduleSave" style="width:110px" />
                <label class="checkbox"><input type="checkbox" @bind="PlotSettings.FftLog" @bind:after="State.ScheduleSave" /> @T("Лог (дБ)", "Log (dB)")</label>
                <span class="label">@T("Окно", "Window")</span>
                <select class="field small" @bind="PlotSettings.FftWindow" @bind:after="State.ScheduleSave">
                    <option value="Rectangular">@T("Прямоугольное", "Rectangular")</option>
                    <option value="Hann">@T("Ханна", "Hann")</option>
                    <option value="Hamming">@T("Хэмминга", "Hamming")</option>
                    <option value="Blackman">@T("Блэкмана", "Blackman")</option>
                    <option value="BlackmanHarris">@T("Блэкмана-Харриса", "Blackman-Harris")</option>
                </select>
            </div>
        }
    </header>

    @if (State.ErrorMessage != null)
    {
        <div class="alert">
            @State.ErrorMessage
            <button class="btn small" @onclick="() => State.ErrorMessage = null">OK</button>
        </div>
    }

    <section class="workspace">
        <div class="plot-card" @ref="_plotElement"
             @onpointerdown="OnPointerDown" @onpointermove="OnPointerMove" @onpointerup="OnPointerUp"
             @onpointerleave="OnPointerLeave" @onpointercancel="OnPointerLeave" @onwheel:preventDefault @ondblclick="OnDoubleClick"
             @oncontextmenu="OnContextMenu" @oncontextmenu:preventDefault>
            @((MarkupString)_svg)

            @if (_contextMenu)
            {
                <div class="context-menu" style="left:@(_contextX)px; top:@(_contextY)px">
                    <button @onclick='() => StartExport("svg")'>@T("Сохранить снимок SVG", "Save SVG snapshot")</button>
                    <button @onclick='() => StartExport("png")'>@T("Сохранить снимок PNG", "Save PNG snapshot")</button>
                    <button @onclick='() => StartExport("csv")'>@T("Экспорт данных в CSV", "Export data to CSV")</button>
                </div>
            }

            <div class="plot-legend">
                @foreach (var channel in VisibleYChannels())
                {
                    <span class="legend-item" style="color:@channel.Color">
                        <span class="legend-swatch" style="background:@channel.Color"></span>
                        @channel.Name = @channel.Last.ToString("0.##", CultureInfo.InvariantCulture)
                    </span>
                }
            </div>
        </div>

        @if (State.ShowChannels)
        {
        <aside class="side-card">
            <div class="card-header">
                <span>@T("Каналы", "Channels")</span>
                <span class="label">@DataHub.Count</span>
            </div>
            <div class="card-body">
                <label class="label" for="x-axis">@T("Ось X", "X axis")</label>
                <select id="x-axis" class="field" style="width:100%; margin:5px 0 10px" value="@State.XIndex" @onchange="OnXIndexChanged">
                    <option value="-1">@T("Время", "Time")</option>
                    @for (int i = 0; i < DataHub.Count; i++)
                    {
                        var channel = DataHub.ChannelAt(i);
                        if (channel != null)
                        {
                            <option value="@i">@channel.Name</option>
                        }
                    }
                </select>

                @if (DataHub.Count == 0)
                {
                    <div class="empty-state">@T("Нет данных — подключись к порту или запусти симулятор.",
                        "No data — connect to a port or start the simulator.")</div>
                }
                else
                {
                    @for (int i = 0; i < DataHub.Count; i++)
                    {
                        var channel = DataHub.ChannelAt(i);
                        if (channel == null)
                            continue;
                        bool isX = i == State.XIndex;
                        <div class="channel-row">
                            <input type="checkbox" checked="@channel.Visible" disabled="@isX" @onchange="e => SetChannelVisible(channel, e)" />
                            <input type="color" @bind="channel.Color" @bind:after="OnChannelConfigChanged" title='@T("Цвет", "Color")' />
                            <span class="channel-name" title="@channel.Name">@channel.Name@(isX ? $" — {T("ось X", "X axis")}" : "")</span>
                            <button class="btn small" @onclick="() => BeginEditChannel(channel)">…</button>
                        </div>
                    }
                }
            </div>
        </aside>
        }
    </section>

    <div class="console-splitter" @ref="_splitterElement" title='@T("Потяни, чтобы изменить высоту консоли", "Drag to resize the console")'
         @onpointerdown="OnSplitterDown" @onpointermove="OnSplitterMove" @onpointerup="OnSplitterUp" @onpointercancel="OnSplitterUp"></div>

    <section class="console-card" style="height:@(_consoleHeight)px">
        <div class="card-header">
            <div class="console-tabs">
                <button class='tab-btn @(_consoleTab == 0 ? "active" : "")' @onclick="() => _consoleTab = 0">@T("Входящие", "Incoming")</button>
                <button class='tab-btn @(_consoleTab == 1 ? "active" : "")' @onclick="() => _consoleTab = 1">@T("Исходящие", "Outgoing")</button>
            </div>
            <div>
                <button class="btn small" @onclick="State.ClearConsole">@T("Очистить", "Clear")</button>
            </div>
        </div>
        <pre class="console-log" @ref="_consoleLog">@string.Join("\n", VisibleConsole())</pre>
        <div class="send-row">
            <input class="field" placeholder='@T("Строка в порт…", "Line to port…")' @bind="_sendText" @onkeydown="OnSendKeyDown" disabled="@(!State.Serial.IsOpen)" />
            <button class="btn" disabled="@(!State.Serial.IsOpen)" @onclick="SendCurrent">@T("Отправить", "Send")</button>
        </div>
    </section>
</div>

@if (State.ShowHelp)
{
    <div class="modal-backdrop" @onclick="() => State.ShowHelp = false">
        <div class="modal wide" @onclick:stopPropagation>
            <div class="modal-header"><span>@T("Справка", "Help")</span><button class="btn small" @onclick="() => State.ShowHelp = false">×</button></div>
            <div class="modal-body"><pre class="help-pre">@HelpText</pre></div>
        </div>
    </div>
}

@if (State.ShowSimulator)
{
    <div class="modal-backdrop" @onclick="() => State.ShowSimulator = false">
        <div class="modal wide" @onclick:stopPropagation>
            <div class="modal-header"><span>@T("Симулятор", "Simulator")</span><button class="btn small" @onclick="() => State.ShowSimulator = false">×</button></div>
            <div class="modal-body">
                @foreach (var channel in State.Sim.Channels)
                {
                    <div class="form-grid" style="margin-bottom:12px; padding-bottom:12px; border-bottom:1px solid var(--border)">
                        <div class="form-field"><span class="label">@T("Имя", "Name")</span><input class="field" @bind="channel.Name" /></div>
                        <div class="form-field"><span class="label">@T("Форма", "Wave")</span>
                            <select class="field" @bind="channel.Wave">
                                <option value="Sine">@T("Синус", "Sine")</option>
                                <option value="Square">@T("Прямоугольник", "Square")</option>
                                <option value="Saw">@T("Пила", "Saw")</option>
                                <option value="Noise">@T("Шум", "Noise")</option>
                                <option value="Constant">@T("Постоянный", "Constant")</option>
                                <option value="Walk">@T("Блуждание", "Walk")</option>
                            </select>
                        </div>
                        <div class="form-field"><span class="label">@T("Частота", "Frequency")</span><input class="field" type="number" step="0.1" @bind="channel.Frequency" /></div>
                        <div class="form-field"><span class="label">@T("Амплитуда", "Amplitude")</span><input class="field" type="number" step="0.1" @bind="channel.Amplitude" /></div>
                        <div class="form-field"><span class="label">@T("Смещение", "Offset")</span><input class="field" type="number" step="0.1" @bind="channel.Offset" /></div>
                        <div class="form-field"><span class="label">&nbsp;</span><button class="btn danger" @onclick="() => State.Sim.Channels.Remove(channel)">@T("Удалить", "Remove")</button></div>
                    </div>
                }
                <button class="btn" @onclick="AddSimulatorChannel">+ @T("Канал", "Channel")</button>
            </div>
            <div class="modal-footer">
                @if (State.Sim.Running)
                {
                    <button class="btn danger" @onclick="State.StopSimulator">@T("Остановить", "Stop")</button>
                }
                else
                {
                    <button class="btn primary" @onclick="State.StartSimulator">@T("Старт", "Start")</button>
                }
            </div>
        </div>
    </div>
}

@if (State.EditingChannel != null)
{
    <div class="modal-backdrop" @onclick="CancelEditChannel">
        <div class="modal" @onclick:stopPropagation>
            <div class="modal-header"><span>@T("Настройки канала", "Channel settings")</span><button class="btn small" @onclick="CancelEditChannel">×</button></div>
            <div class="modal-body form-grid">
                <div class="form-field full"><span class="label">@T("Имя", "Name")</span><input class="field" @bind="_editName" /></div>
                <div class="form-field"><span class="label">@T("Цвет", "Color")</span><input class="field" type="color" @bind="_editColor" /></div>
                <div class="form-field"><span class="label">@T("Толщина", "Width")</span><input class="field" type="number" min="0.5" max="10" step="0.5" @bind="_editWidth" /></div>
                <div class="form-field"><span class="label">@T("Линия", "Line")</span>
                    <select class="field" @bind="_editLineStyle">
                        <option value="Solid">@T("Сплошная", "Solid")</option>
                        <option value="Dash">@T("Штриховая", "Dash")</option>
                        <option value="Dot">@T("Пунктир", "Dot")</option>
                        <option value="DashDot">@T("Штрих-пунктир", "Dash-dot")</option>
                    </select>
                </div>
                <div class="form-field"><span class="label">@T("Сглаживание", "Smoothing")</span>
                    <select class="field" @bind="_editSmooth">
                        <option value="None">@T("Нет", "None")</option>
                        <option value="MovingAverage">@T("Скользящее среднее", "Moving average")</option>
                        <option value="Median">@T("Медиана", "Median")</option>
                        <option value="Gaussian">@T("Гауссово", "Gaussian")</option>
                        <option value="Exponential">@T("Экспоненциальное", "Exponential")</option>
                    </select>
                </div>
                <div class="form-field"><span class="label">@T("Окно, точек", "Window, points")</span><input class="field" type="number" min="3" max="501" step="2" @bind="_editSmoothWindow" /></div>
            </div>
            <div class="modal-footer">
                <button class="btn" @onclick="CancelEditChannel">@T("Отмена", "Cancel")</button>
                <button class="btn primary" @onclick="ApplyEditChannel">OK</button>
            </div>
        </div>
    </div>
}

@if (State.ShowRanges)
{
    <div class="modal-backdrop" @onclick="() => State.ShowRanges = false">
        <div class="modal" @onclick:stopPropagation>
            <div class="modal-header"><span>@T("Диапазоны графика", "Plot ranges")</span><button class="btn small" @onclick="() => State.ShowRanges = false">×</button></div>
            <div class="modal-body form-grid">
                <label class="checkbox full"><input type="checkbox" @bind="PlotSettings.YAuto" /> @T("Автодиапазон Y", "Auto Y range")</label>
                <div class="form-field"><span class="label">Y min</span><input class="field" @bind="_rangeYMin" /></div>
                <div class="form-field"><span class="label">Y max</span><input class="field" @bind="_rangeYMax" /></div>
                <label class="checkbox full"><input type="checkbox" @bind="PlotSettings.XAuto" /> @T("Автоокно X", "Auto X window")</label>
                <div class="form-field"><span class="label">X min</span><input class="field" @bind="_rangeXMin" /></div>
                <div class="form-field"><span class="label">X max</span><input class="field" @bind="_rangeXMax" /></div>
                <div class="form-field full"><span class="label">@T("Хвост полярного графика", "Polar trail")</span><input class="field" type="number" min="10" max="10000" @bind="PlotSettings.PolarTrail" /></div>
            </div>
            <div class="modal-footer">
                <button class="btn" @onclick="ResetView">@T("Сбросить вид", "Reset view")</button>
                <button class="btn primary" @onclick="ApplyRanges">OK</button>
            </div>
        </div>
    </div>
}

@if (State.ShowExportRange)
{
    <div class="modal-backdrop" @onclick="() => State.ShowExportRange = false">
        <div class="modal" @onclick:stopPropagation>
            <div class="modal-header"><span>@T("Отрезок экспорта", "Export segment")</span><button class="btn small" @onclick="() => State.ShowExportRange = false">×</button></div>
            <div class="modal-body form-grid">
                <label class="checkbox full"><input type="checkbox" @bind="_exportUseX" /> @T("Отрезок по оси X", "X-axis segment")</label>
                <div class="form-field"><span class="label">X from</span><input class="field" @bind="_exportXFrom" /></div>
                <div class="form-field"><span class="label">X to</span><input class="field" @bind="_exportXTo" /></div>
                @if (State.Mode == PlotMode.Time)
                {
                    <label class="checkbox full"><input type="checkbox" @bind="_exportUseY" /> @T("Обрезать по Y", "Crop by Y")</label>
                    <div class="form-field"><span class="label">Y from</span><input class="field" @bind="_exportYFrom" /></div>
                    <div class="form-field"><span class="label">Y to</span><input class="field" @bind="_exportYTo" /></div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn" @onclick="() => State.ShowExportRange = false">@T("Отмена", "Cancel")</button>
                <button class="btn primary" @onclick="ConfirmExport">@T("Экспорт", "Export")</button>
            </div>
        </div>
    </div>
}

@code {
    private ElementReference _plotElement;
    private ElementReference _consoleLog;
    private ElementReference _splitterElement;
    private DotNetObjectReference<Home>? _hotkeysReference;
    private Timer? _renderTimer;
    private string _svg = "";
    private readonly List<string> _consoleLines = new();
    private int _consoleTab;
    private string _sendText = "";
    private int _consoleHeight = 150;
    private bool _consoleDirty;
    private bool _draggingSplitter;
    private double _splitterStartY;
    private int _splitterStartHeight;
    private bool _toolsOpen;

    private bool _contextMenu;
    private double _contextX, _contextY;
    private bool _selecting, _dragMoved, _panning, _dragging3d, _suppressMarker;
    private PlotRect _selection;
    private (double X, double Y) _dragStart, _lastMouse, _mousePosition;

    private string _editName = "", _editColor = "#00e5ff";
    private float _editWidth = 2;
    private LineKind _editLineStyle;
    private SmoothKind _editSmooth;
    private int _editSmoothWindow = 5;

    private string _rangeYMin = "-1", _rangeYMax = "1", _rangeXMin = "0", _rangeXMax = "400";
    private string _exportKind = "svg";
    private bool _exportUseX, _exportUseY;
    private string _exportXFrom = "0", _exportXTo = "400", _exportYFrom = "-1", _exportYTo = "1";
    private bool _disposed;

    protected override void OnInitialized()
    {
        State.Initialize();
        State.Changed += OnStateChanged;
        _rangeYMin = PlotSettings.YMin.ToString(CultureInfo.InvariantCulture);
        _rangeYMax = PlotSettings.YMax.ToString(CultureInfo.InvariantCulture);
        _rangeXMin = PlotSettings.XMin.ToString(CultureInfo.InvariantCulture);
        _rangeXMax = PlotSettings.XMax.ToString(CultureInfo.InvariantCulture);
        if (int.TryParse(Environment.GetEnvironmentVariable("SERIALPLOTTER_CONSOLE"), out int consoleHeight))
            _consoleHeight = Math.Clamp(consoleHeight, 86, 520);
        _toolsOpen = Environment.GetEnvironmentVariable("SERIALPLOTTER_TOOLS") == "1";
        _renderTimer = new Timer(_ => _ = InvokeAsync(RenderFrame), null, 0, 33);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _hotkeysReference = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("spHotkeys.init", _hotkeysReference);
            await JS.InvokeVoidAsync("spPlotWheel.init", _plotElement, _hotkeysReference);
            await JS.InvokeVoidAsync("spSetTheme", State.ThemeName);
        }
        if (_consoleDirty)
        {
            _consoleDirty = false;
            await JS.InvokeVoidAsync("spScrollToEnd", _consoleLog);
        }
    }

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    private void RenderFrame()
    {
        if (_disposed)
            return;
        try
        {
            if (State.Mode == PlotMode.ThreeD && State.Spin3D && !_dragging3d)
                State.RotationY += 0.004;

            var newLines = State.DrainConsole();
            foreach (string line in newLines)
            {
                _consoleLines.Add(line);
                if (_consoleLines.Count > 1000)
                    _consoleLines.RemoveRange(0, _consoleLines.Count - 1000);
            }
            _consoleDirty |= newLines.Count > 0;
            _svg = BuildSvg(forExport: false);
            StateHasChanged();
        }
        catch
        {
            // Один плохой кадр не должен останавливать монитор.
        }
    }

    private string BuildSvg(bool forExport)
    {
        var context = new PlotContext
        {
            Mode = State.Mode,
            Visible = DataHub.Channels.Where(c => c.Visible).ToList(),
            XIndex = State.XIndex,
            RotX = State.RotationX,
            RotY = State.RotationY,
            Time3DAxis = State.Time3DAxis,
            MouseX = forExport ? -1 : _mousePosition.X,
            MouseY = forExport ? -1 : _mousePosition.Y,
            Selection = forExport || _selection.Width <= 0 ? null : _selection,
            ForExport = forExport,
        };
        return SvgPlotter.RenderSvg(context);
    }

    private string T(string ru, string en) => Lang.T(ru, en);

    private int VisibleChannelCount() => DataHub.Channels.Count(c => c.Visible);

    private IEnumerable<Channel> VisibleYChannels()
    {
        var visible = DataHub.Channels.Where(c => c.Visible).ToList();
        var x = State.XIndex >= 0 && State.XIndex < DataHub.Count ? DataHub.ChannelAt(State.XIndex) : null;
        return x == null ? visible : visible.Where(c => !ReferenceEquals(c, x));
    }

    private IEnumerable<string> VisibleConsole() =>
        _consoleTab == 0 ? _consoleLines.Where(l => !l.Contains("] >> ")) : _consoleLines.Where(l => l.Contains("] >> "));

